# ─── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:Harshit@12b@localhost:5432/talentbridge"

# ─── JWT ───────────────────────────────────────────────
# REQUIRED in production — server refuses to start without it.
